<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Lokalne testy bez konta deweloperskiego Apple: bez CloudKit / iCloud.
	     Pełną wersję trzymaj w aegis.CloudKit.entitlements — po odblokowaniu
	     skopiuj stamtąd klucze iCloud z powrotem tutaj. -->
	<key>com.apple.security.network.client</key>
	<true/>
</dict>
</plist>
